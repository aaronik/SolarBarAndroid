<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.aaronik.solarbar" android:versionCode="5" android:versionName="0.1.4">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:name=".SolarApp" android:label="SolarBar" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".LauncherActivity" android:exported="true" android:taskAffinity=""
            android:noHistory="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".SolarReceiver" android:exported="false" />
    </application>
</manifest>
